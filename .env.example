# Domain untuk Gitea (tanpa https://)
DOMAIN=git.yourdomain.com

# Password database PostgreSQL (ganti dengan password yang kuat)
DB_PASSWORD=change_this_to_a_strong_password

# Secret key untuk Gitea (generate dengan: openssl rand -hex 32)
SECRET_KEY=change_this_generate_with_openssl_rand_hex_32

# Internal token (generate dengan: openssl rand -hex 32)
INTERNAL_TOKEN=change_this_generate_with_openssl_rand_hex_32

# Set false jika ingin mengizinkan registrasi publik
DISABLE_REGISTRATION=true
